!opt_geogrid_tbl_path = '/oceano/gmeteo/WORK/ASNA/WRF/Binaries/tests/WRF_3.4.1_r2070_INTEL_SERIAL_patch_CLWRFGHG/WPS/geogrid',
/

&ungrib
